# Скопируйте в .env.local и заполните на этапе «Realtime» (Supabase → Project Settings → API).
# Эти два значения публичные: безопасность обеспечивают политики RLS из supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Секретный ключ service_role НИКОГДА не кладите в переменные с префиксом NEXT_PUBLIC_
# и не добавляйте в код сайта. Проекту он не нужен.
