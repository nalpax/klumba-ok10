# Скопируйте в .env (для Docker) или задайте в настройках хостинга.

# Пароль администратора: вводится в окне «Вход» вместо кода. Обязателен — без него вход в админку выключен.
# Придумайте длинный (от 12 знаков), в браузер он не попадает.
ADMIN_PASSWORD=

# Адрес сайта — для QR-кодов и превью ссылки в мессенджерах. Например: https://klumba-ok10.ru
NEXT_PUBLIC_SITE_URL=

# Где хранить данные (коды, посадки). В Docker — /data (том). По умолчанию ./data
# DATA_DIR=/data

# 1 — при самом первом запуске заполнить клумбу демо-учителями и демо-цветами (для пробы)
# SEED_DEMO=1
